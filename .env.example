# AI Provider: 'mock' (zero-dependency local test) or 'gemini' (live Google Gemini API)
AI_PROVIDER=mock

# Gemini API Key (Required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret Key (Must be at least 32 characters in production)
SECRET_KEY=supersecretkey-change-in-production-min32chars

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL=sqlite:///./contact_center.db
# PostgreSQL with pgvector (for Docker or production):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/contact_center_db

# Storage directory for uploaded documents and OCR artifacts
STORAGE_DIR=./storage

# Autonomy & Guardrails Configuration
AUTONOMOUS_REFUND_LIMIT=50.0
AGENT_APPROVAL_REFUND_LIMIT=500.0
